# Copy this file to .env. The real .env is ignored by Git.
STOCK_AGENT_APP_DIR=/opt/stock-agent
STOCK_AGENT_CONFIG=/var/lib/stock-agent/strategy_config.json
STOCK_AGENT_HISTORY_PATH=/var/lib/stock-agent/recommendation_history.json
STOCK_AGENT_PORTFOLIO_PATH=/var/lib/stock-agent/strategy_portfolios.json
STOCK_AGENT_MARKET_HISTORY_CACHE_DIR=/var/lib/stock-agent/market_history_cache
STOCK_AGENT_BOARD_UNIVERSE_CACHE_DIR=/var/lib/stock-agent/board_universe_cache
STOCK_AGENT_BACKTEST_DATASET_PATH=
STOCK_AGENT_PUBLIC_URL=http://127.0.0.1:8765

STOCK_AGENT_LLM_BASE_URL=http://127.0.0.1:8911/v1
STOCK_AGENT_LLM_MODEL=your-model
STOCK_AGENT_LLM_API_KEY=
STOCK_AGENT_LLM_TIMEOUT=30
STOCK_AGENT_RUN_BUDGET_SECONDS=100

STOCK_AGENT_PYTHON=/usr/bin/python3
STOCK_AGENT_RUN_PYTHON=/usr/bin/python3
STOCK_AGENT_RUN_MODE=ai
STOCK_AGENT_RUN_TIMEOUT=240
STOCK_AGENT_CANDIDATE_LIMIT=6
STOCK_AGENT_ENABLE_TICK=1
STOCK_AGENT_TICK_LIMIT=2
STOCK_AGENT_HISTORY_CACHE_TTL_SECONDS=21600
STOCK_AGENT_HISTORY_FETCH_ATTEMPTS=1
STOCK_AGENT_HISTORY_FETCH_BACKOFF_SECONDS=1
STOCK_AGENT_HISTORY_FETCH_WORKERS=2
STOCK_AGENT_HISTORY_BACKGROUND_REFRESH=1
STOCK_AGENT_HISTORY_BACKGROUND_WORKERS=4
STOCK_AGENT_ENRICH_TOTAL_BUDGET_SECONDS=30
STOCK_AGENT_SOURCE_RETRIES=2
STOCK_AGENT_BOARD_UNIVERSE_LIMIT=1000
STOCK_AGENT_BOARD_SNAPSHOT_MAX_AGE_DAYS=7
STOCK_AGENT_SINA_QUOTE_BATCH_SIZE=80
STOCK_AGENT_SIGNAL_UNIVERSE_LIMIT=0
STOCK_AGENT_MIN_BOARD_HISTORY_COUNT=30
STOCK_AGENT_MIN_BOARD_HISTORY_COVERAGE_RATIO=0.7
STOCK_AGENT_MIN_QUOTE_COVERAGE_RATIO=0.8

STOCK_AGENT_HERMES_BIN=/usr/local/bin/hermes
STOCK_AGENT_HERMES_JOB_ID=
STOCK_AGENT_HERMES_TRACKING_JOB_ID=
STOCK_AGENT_HERMES_RISK_JOB_ID=

STOCK_AGENT_DEFAULT_DELIVERY_ENABLED=0
STOCK_AGENT_DEFAULT_DELIVERY_CHANNEL=feishu
STOCK_AGENT_DEFAULT_DELIVERY_TARGET=
STOCK_AGENT_DEFAULT_DELIVERY_HOUR=8
STOCK_AGENT_DEFAULT_DELIVERY_MINUTE=0
STOCK_AGENT_DEFAULT_DELIVERY_FREQUENCY=weekdays
